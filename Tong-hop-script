-- Tự động tải danh sách script từ file scripts.json trên GitHub
task.spawn(function()
    local Success, Response = pcall(function()
        return game:HttpGet(SCRIPT_LIST_URL)
    end)
    
    if Success then
        local DecodeSuccess, ScriptData = pcall(function()
            return HttpService:JSONDecode(Response)
        end)
        
        if DecodeSuccess and type(ScriptData) == "table" then
            for _, item in ipairs(ScriptData) do
                if item.Name and item.Url then
                    CreateScriptButton(item.Name, item.Url)
                end
            end
        else
            warn("[Atras | GiaBình] Lỗi giải mã JSON danh sách script!")
        end
    else
        warn("[Atras | GiaBình] Không thể kết nối tới server chứa danh sách script!")
    end
end)

